programa {
  funcao inicio() {
    real baseTriangulo, alturaTriangulo, areaTriangulo
      escreva("Base: ")
      leia(baseTriangulo)
      escreva("Altura: ")
      leia(alturaTriangulo)
        areaTriangulo = baseTriangulo * alturaTriangulo
      escreva("Área do triângulo: ", areaTriangulo)
  }
}
